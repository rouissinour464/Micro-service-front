# =============================================================
# CONFIGURATION REACT — ENVIRONNEMENT DÉVELOPPEMENT
# Ces variables sont injectées dans le bundle au moment du build
# (react-scripts les expose sous window.process.env.REACT_APP_*)
# =============================================================

# URL de base pour tous les appels API généraux (auth, users, admin…)
# Chemin relatif → les requêtes partent vers le même hôte que la page
# En dev : http://localhost:3000/api  → proxifié par Nginx ou CRA proxy
# En prod : https://mondomaine.com/api → intercepté par Nginx
REACT_APP_API_URL=/api

# URL de base pour les appels spécifiques au service Stage
# (offres, demandes, livrables, commentaires, soutenances, encadrants)
# Séparée de REACT_APP_API_URL pour pouvoir pointer vers un autre
# domaine/port sans toucher au code (ex. staging vs prod)
REACT_APP_STAGE_API_URL=/api

# Délai maximum d'attente d'une réponse HTTP, en millisecondes
# 15000 ms = 15 secondes. Au-delà, la requête axios/fetch est annulée
# et une erreur est remontée à l'interface utilisateur
REACT_APP_API_TIMEOUT=15000