# =============================================================
# CONFIGURATION REACT — ENVIRONNEMENT PRODUCTION
# Utilisé automatiquement par "react-scripts build"
# Ces variables sont figées dans le bundle JS au moment du build :
# elles ne peuvent PAS être changées après déploiement
# =============================================================

# URL de base pour tous les appels API généraux
# En production, /api est intercepté par Nginx qui proxifie
# vers l'API Gateway sur le réseau Docker interne
REACT_APP_API_URL=/api

# URL de base pour les appels spécifiques au service Stage
# Identique à REACT_APP_API_URL ici, mais découplée pour
# permettre une configuration différente si besoin (ex. CDN, autre domaine)
REACT_APP_STAGE_API_URL=/api

# Délai maximum d'attente d'une réponse HTTP, en millisecondes
# 15 secondes — même valeur qu'en développement
REACT_APP_API_TIMEOUT=15000

# Force le mode production de React :
# - Bundle JS minifié et optimisé
# - Pas de warnings de développement dans la console
# - Désactivation des outils de debug (Redux DevTools, etc.)
# Note : react-scripts build l'injecte automatiquement,
# mais le déclarer ici garantit sa présence avec d'autres bundlers
NODE_ENV=production
